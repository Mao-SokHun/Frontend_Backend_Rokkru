# First time setup (this file IS in git; .env.docker is NOT):
#   cp .env.docker.example .env.docker
#
# Then start:
#   docker compose up --build
#
# DATABASE: pick ONE option
# -----------------------------------------------
# Option A (recommended): same DB as local backend — copy DATABASE_URL from backend_rokkru/.env
# Leave DATABASE_URL unset here if backend_rokkru/.env already exists; Docker loads it automatically.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_SSL=true
#
# Option B: bundled Postgres (add --profile local-db)
# DATABASE_URL=postgres://rokkru:rokkru@db:5432/rokkru
# DB_SSL=false

POSTGRES_USER=rokkru
POSTGRES_PASSWORD=rokkru
POSTGRES_DB=rokkru
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=80

CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
FRONTEND_URL=http://localhost
VITE_API_URL=/api

# Only needed if backend_rokkru/.env is missing (e.g. CI)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
LOGINLIMIT=100
REGISTERLIMIT=50

# Optional integrations (or copy from backend_rokkru/.env)
EMAIL_USER=
EMAIL_PASS=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
