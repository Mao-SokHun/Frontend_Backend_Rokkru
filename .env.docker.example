# First time setup (this file IS in git; .env.docker is NOT):
#   cp .env.docker.example .env.docker
#
# Then start:
#   docker compose up --build
# User types (Student, Teacher, Admin) are auto-seeded when the backend container starts.
#
# DATABASE — bundled PostgreSQL in Docker (default):
DATABASE_URL=postgres://rokkru:rokkru@db:5432/rokkru
DB_SSL=false
#
# Or PostgreSQL on your host machine (not in Docker):
# DATABASE_URL=postgres://USER:PASSWORD@host.docker.internal:5432/DBNAME
# DB_SSL=false

POSTGRES_USER=rokkru
POSTGRES_PASSWORD=rokkru
POSTGRES_DB=rokkru
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=80

CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
FRONTEND_URL=http://localhost
VITE_API_URL=/api

# JWT — only if backend_rokkru/.env is missing (e.g. CI)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
LOGINLIMIT=100
REGISTERLIMIT=50

EMAIL_USER=
EMAIL_PASS=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
